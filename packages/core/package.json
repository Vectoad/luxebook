{
  "name": "@vectoad/luxebook-core",
  "version": "0.1.3",
  "description": "Turn any PDF into a realistic 3D flipbook. Framework-free viewer with page-turn physics, covers, lighting and paper finishes.",
  "keywords": [
    "pdf",
    "pdf-viewer",
    "flipbook",
    "page-flip",
    "page-turn",
    "3d",
    "book",
    "brochure",
    "magazine",
    "catalog",
    "threejs",
    "webgl",
    "pdfjs"
  ],
  "homepage": "https://vectoad.github.io/luxebook/",
  "bugs": "https://github.com/Vectoad/luxebook/issues",
  "author": "Vectoad",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "luxebook-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig ../../tsconfig.base.json",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "@vectoad/luxebook-animations": "workspace:*",
    "@vectoad/luxebook-page-physics": "workspace:*",
    "@vectoad/luxebook-pdf-engine": "workspace:*",
    "@vectoad/luxebook-renderer-three": "workspace:*",
    "@vectoad/luxebook-types": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vectoad/luxebook.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
