{
  "name": "@vectoad/luxebook-react",
  "version": "0.1.2",
  "description": "Turn any PDF into a realistic 3D flipbook. React component with page-turn physics, covers, lighting and paper finishes.",
  "keywords": [
    "pdf",
    "pdf-viewer",
    "flipbook",
    "page-flip",
    "page-turn",
    "3d",
    "book",
    "brochure",
    "magazine",
    "catalog",
    "threejs",
    "webgl",
    "pdfjs",
    "react",
    "react-component"
  ],
  "homepage": "https://vectoad.github.io/luxebook/",
  "bugs": "https://github.com/Vectoad/luxebook/issues",
  "author": "Vectoad",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "luxebook-source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --sourcemap --external react --external react-dom --tsconfig ../../tsconfig.base.json"
  },
  "dependencies": {
    "@vectoad/luxebook-core": "workspace:*",
    "@vectoad/luxebook-types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vectoad/luxebook.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
