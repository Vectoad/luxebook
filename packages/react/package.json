{
  "name": "@vectoad/luxebook-react",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "luxebook-source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --sourcemap --external react --external react-dom --tsconfig ../../tsconfig.base.json"
  },
  "dependencies": {
    "@vectoad/luxebook-types": "workspace:*",
    "@vectoad/luxebook-core": "workspace:*"
  },
  "devDependencies": {
    "react": "18.3.1",
    "@types/react": "18.3.31",
    "react-dom": "18.3.1",
    "@types/react-dom": "18.3.7"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vectoad/luxebook.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
