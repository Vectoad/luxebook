{
  "name": "luxebook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @vectoad/luxebook-playground dev",
    "fixtures": "node scripts/generate-fixtures.mjs"
  },
  "devDependencies": {
    "@vectoad/luxebook-core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "pdf-lib": "1.17.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
