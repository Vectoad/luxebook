{
  "name": "@vectoad/luxebook-types",
  "version": "0.1.2",
  "description": "Internal building block of Luxebook, the 3D PDF flipbook. Use @vectoad/luxebook-react or @vectoad/luxebook-core.",
  "homepage": "https://vectoad.github.io/luxebook/",
  "bugs": "https://github.com/Vectoad/luxebook/issues",
  "author": "Vectoad",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "luxebook-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig ../../tsconfig.base.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vectoad/luxebook.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
